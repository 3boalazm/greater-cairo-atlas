{
  "name": "greater-cairo-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Documented, source-backed interactive geospatial atlas of Greater Cairo, Egypt.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dry-run": "tsx scripts/migrate.ts --dry-run",
    "seed:import": "tsx scripts/import-seed.ts",
    "seed:check": "tsx scripts/import-seed.ts --dry-run",
    "env:check": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
