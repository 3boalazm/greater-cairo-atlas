# Greater Cairo Atlas — Environment Configuration Template
# Copy to .env.local for local development:
#   cp .env.example .env.local
# NEVER commit .env or .env.local containing real credentials.

# Required for database connectivity, migrations, and healthy /api/health responses.
# Obtain from Neon Console -> Connection Details (pooled or direct postgresql:// URL with sslmode=require).
DATABASE_URL="postgresql://<role>:<password>@<endpoint>.neon.tech/<database>?sslmode=require"

# Optional structured log verbosity: debug | info | warn | error | silent (default: info)
LOG_LEVEL="info"
