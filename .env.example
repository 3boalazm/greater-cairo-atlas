# Greater Cairo Atlas — Environment Configuration Template
# Copy to .env.local for local development:
#   cp .env.example .env.local
# NEVER commit .env or .env.local containing real credentials.

# Required for serverless HTTP queries (/api/health, /api/atlas/stats).
# Automatically injected by the Neon Vercel Integration in Production/Preview/Development.
DATABASE_URL="postgresql://<role>:<password>@<endpoint>-pooler.neon.tech/<database>?sslmode=require"

# Optional direct (non-pooled) Neon connection string preferred for SQL migrations
# and session-level pg_advisory_lock. Automatically set by the Neon Vercel Integration;
# falls back to DATABASE_URL when omitted.
DATABASE_URL_UNPOOLED="postgresql://<role>:<password>@<endpoint>.neon.tech/<database>?sslmode=require"

# Optional structured log verbosity: debug | info | warn | error | silent (default: info)
LOG_LEVEL="info"
